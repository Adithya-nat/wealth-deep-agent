# Copy to .env and fill in. .env is gitignored; THIS FILE IS NOT.
# Never put a real key in this file — it is committed.

# --- Models -----------------------------------------------------------------
# The supervisor and the deep subagents run on Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Used for the LLM-as-judge in evals/ so the judge is a *different*
# model family from the agent under test — see WORKSHOP_BRIEF.md on why that
# matters for judge independence.
OPENAI_API_KEY=sk-...

# --- Observability ----------------------------------------------------------
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=wealth-deep-agent

# --- Research ---------------------------------------------------------------
TAVILY_API_KEY=tvly-...

# --- Robinhood MCP ----------------------------------------------------------
# No key needed. These servers use OAuth 2.1 (Dynamic Client Registration +
# PKCE); `wealth auth login` runs the browser flow once and caches the refresh
# token under ~/.wealth-agent/.
#
# Note the two different hosts. `agent.robinhood.com/mcp/banking` answers, but
# advertises its canonical resource as `banking-agent.robinhood.com/mcp/banking`
# — and the MCP SDK enforces RFC 9728 resource matching, so the convenient URL
# fails the flow with "Protected resource ... does not match expected ...".
# Always use the identifier the server names in its own metadata.
ROBINHOOD_TRADING_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_BANKING_MCP_URL=https://banking-agent.robinhood.com/mcp/banking

# Known limitation, not a bug in this repo: the banking server completes the
# OAuth flow and mints a valid `credit-card`-scoped token, then answers
# `401 client id not allowed` — it admits only pre-registered MCP clients
# (Claude, ChatGPT, Cursor), and a dynamically-registered one is not on that
# list. Trading has no such restriction. `wealth run --live` therefore uses
# live trading data and falls back to fixtures for banking, and says so.

# --- Demo safety ------------------------------------------------------------
# 1 = replay scrubbed fixtures from artifacts/, never touch a live account.
#     This is the default, and it is what you present with.
# 0 = talk to the real MCP servers. Read tools only unless ALLOW_WRITE_TOOLS=1.
DEMO_MODE=1

# Exposes order placement / card purchase to the model. Every one of these is
# additionally gated behind a human-in-the-loop interrupt. Leave at 0 unless
# you are deliberately demoing the approval gate against a funded Agentic
# account.
ALLOW_WRITE_TOOLS=0
