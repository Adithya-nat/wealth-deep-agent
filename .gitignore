# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets — never commit
.env
.env.local
*.token.json
secrets/

# OAuth token cache (also lives in ~/.wealth-agent, this is belt-and-braces)
.auth/

